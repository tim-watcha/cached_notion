# .gitignore

# Ignore Python build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*~

# Ignore Poetry artifacts
/poetry.lock

# Ignore IDE artifacts
.idea/
.vscode/
*.swp
*.swo

# Ignore build output and virtualenvs
/dist/
.venv/

# Ignore OS artifacts
.DS_Store

# Ignore the local Notion cache — it holds real workspace content
*.sqlite

